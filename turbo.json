{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig.base.json"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "APP_ENV",
        "ENABLED_LANES",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_TARGET_ENV",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_NL_URL",
        "SUPABASE_NL_SECRET_KEY",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_MODEL_ANALYSIS",
        "ANTHROPIC_MODEL_FAST",
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "GOOGLE_CLOUD_PROJECT_ID",
        "GMAIL_PUBSUB_TOPIC",
        "GRAPH_TENANT_ID",
        "GRAPH_CLIENT_ID",
        "GRAPH_CLIENT_SECRET",
        "INTUIT_CLIENT_ID",
        "INTUIT_CLIENT_SECRET",
        "INTUIT_ENVIRONMENT",
        "INTUIT_REDIRECT_URI",
        "INTUIT_WEBHOOK_VERIFIER_TOKEN",
        "STRIPE_RESTRICTED_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "GHL_PRIVATE_INTEGRATION_TOKEN",
        "GHL_LOCATION_ID",
        "MONDAY_API_TOKEN",
        "NOTION_INTEGRATION_TOKEN",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "test:bundle": {
      "inputs": [
        "app/**",
        "components/**",
        "lib/**",
        "proxy.ts",
        "instrumentation.ts",
        "next.config.ts",
        "package.json",
        "tsconfig.json",
        "scripts/client-bundle-check.mjs",
        "tests/bundle/**",
        "vitest.bundle.config.ts",
        "../../packages/*/src/**",
        "../../packages/*/package.json"
      ],
      "outputs": []
    }
  }
}
