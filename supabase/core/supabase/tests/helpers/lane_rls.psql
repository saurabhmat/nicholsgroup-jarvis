-- Shared pgTAP helpers (T-013). Include from a test with `\ir helpers/lane_rls.psql` after `begin;`.
-- Everything is created in pg_temp and disappears with the test's transaction.

-- Sets the JWT claims for a seeded persona. Call as postgres, then `set local role authenticated`.
create function pg_temp.claims(p_email text, p_aal text) returns text language sql as $$
  select set_config('request.jwt.claims',
    json_build_object('sub', (select id from auth.users where email = p_email), 'role', 'authenticated', 'aal', p_aal)::text, true);
$$;

-- A persona's user id. Security definer (test-only, owned by postgres) so it also works after `set role
-- authenticated`, which cannot read auth.users.
create function pg_temp.uid(p_email text) returns uuid language sql security definer as $$
  select id from auth.users where email = p_email;
$$;

-- core.allowed_lanes(uid, view) for a persona asking about itself at the given AAL, called as authenticated.
create function pg_temp.lanes_for(p_email text, p_view text, p_aal text default 'aal2') returns text[] language plpgsql as $$
declare
  v_uid uuid := pg_temp.uid(p_email);
  v_result text[];
begin
  perform pg_temp.claims(p_email, p_aal);
  set local role authenticated;
  v_result := core.allowed_lanes(v_uid, p_view);
  reset role;
  return v_result;
end;
$$;

-- Asserts the standard lane policy (architecture §5.4) on a lane-scoped table: RLS enabled, a SELECT policy for
-- authenticated that requires aal2 and filters lane_id through core.allowed_lanes(auth.uid(), p_view), no policy
-- for anon or public, and no DML grants to anon/authenticated. Returns one pgTAP line (use with plan()).
create function pg_temp.has_standard_lane_policy(p_table regclass, p_view text) returns text language plpgsql as $$
declare
  v_problems text[] := '{}';
  v_qual text;
begin
  if not (select relrowsecurity from pg_class where oid = p_table) then
    v_problems := v_problems || 'RLS disabled';
  end if;
  select pg_get_expr(p.polqual, p.polrelid) into v_qual
  from pg_policy p
  where p.polrelid = p_table and p.polcmd in ('r', '*')
    and p.polroles = array[(select oid from pg_roles where rolname = 'authenticated')]::oid[]
  limit 1;
  if v_qual is null then
    v_problems := v_problems || 'no SELECT policy for authenticated';
  else
    if v_qual !~ '''aal2''' then v_problems := v_problems || 'policy does not require aal2'; end if;
    if v_qual !~ 'lane_id' then v_problems := v_problems || 'policy does not filter lane_id'; end if;
    if v_qual !~ ('core\.allowed_lanes\(.*auth\.uid\(\).*''' || p_view || '''') then
      v_problems := v_problems || format('policy does not call core.allowed_lanes(auth.uid(), %L)', p_view);
    end if;
  end if;
  if exists (select 1 from pg_policy p where p.polrelid = p_table
             and (0 = any (p.polroles) or (select oid from pg_roles where rolname = 'anon') = any (p.polroles))) then
    v_problems := v_problems || 'policy for public or anon';
  end if;
  if has_table_privilege('anon', p_table, 'select, insert, update, delete')
     or has_table_privilege('authenticated', p_table, 'insert, update, delete') then
    v_problems := v_problems || 'DML or anon grants';
  end if;
  return ok(cardinality(v_problems) = 0,
            format('%s has the standard lane policy (view %L)', p_table, p_view))
         || case when cardinality(v_problems) > 0 then E'\n# ' || array_to_string(v_problems, E'\n# ') else '' end;
end;
$$;
