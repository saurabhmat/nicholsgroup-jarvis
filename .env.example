# Copy to .env.local (git-ignored). Real values live in 1Password ("Executive Portal" vault).
# Never commit real values. Claude Code agents are blocked from reading .env files.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local                      # local | staging | production
ENABLED_LANES=PKG

# --- Supabase (Core project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server only
SUPABASE_DB_PASSWORD=
# Reserved for later rollout: separate Nichols Law project
# SUPABASE_NL_URL=
# SUPABASE_NL_SERVICE_ROLE_KEY=

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ANALYSIS=          # e.g. Sonnet-class model id
ANTHROPIC_MODEL_FAST=              # e.g. Haiku-class model id

# --- Sign-in provider (set ONE, per open decision 1) ---
AUTH_PROVIDER=                     # google | azure
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Mail / calendar / documents connector ---
GOOGLE_CLOUD_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- QuickBooks Online (Intuit) ---
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_ENVIRONMENT=sandbox         # sandbox | production
INTUIT_REDIRECT_URI=http://localhost:3000/api/connect/qbo/callback
INTUIT_WEBHOOK_VERIFIER_TOKEN=

# --- Stripe ---
STRIPE_RESTRICTED_KEY=             # read-only restricted key
STRIPE_WEBHOOK_SECRET=

# --- GoHighLevel ---
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=

# --- monday.com ---
MONDAY_API_TOKEN=

# --- Notion ---
NOTION_INTEGRATION_TOKEN=

# --- Web push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
