# Copy to .env.local (git-ignored). Real values live in 1Password ("Executive Portal" vault).
# Never commit real values. Claude Code agents are blocked from reading .env files.
# NEXT_PUBLIC_* values are shipped to the browser: never put a secret in one.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local                      # local | staging | production
ENABLED_LANES=PKG

# --- Supabase (Core project) ---
# Local: values printed by `supabase status`. Preview: staging project. Production: jarvis-prod.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_...
SUPABASE_SECRET_KEY=               # sb_secret_... server only; jobs + token vault only
# Migrations use the CLI with SUPABASE_ACCESS_TOKEN / SUPABASE_*_DB_PASSWORD as GitHub secrets, not app env.
# Reserved for later rollout: separate Nichols Law project
# SUPABASE_NL_URL=
# SUPABASE_NL_SECRET_KEY=

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# --- Mail / calendar / documents connector (set ONE family, per D-1) ---
# Sign-in does not use these (D-6: Supabase email code + TOTP).
# Google Workspace
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connect/google/callback   # must match the Google client; https outside local
GOOGLE_CLOUD_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=
# Microsoft 365 (Graph)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Composio (Gmail + Google Calendar via Composio, D-30; AI Brain spec §8) ---
# Org/project owned by a PubK/Nichols admin account, Zero Data Retention on (H-039).
# Server-only: never NEXT_PUBLIC_*, never in prompts or logs. Production: Vault/Vercel Production env only.
COMPOSIO_API_KEY=
# Auth config ids (not secrets; Composio project settings, H-039). Each toolkit without its id shows "Not configured" on
# Settings -> Connections. Per deployment (each Composio project has its own ids), never per company (rule 2).
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=

# --- QuickBooks Online (Intuit) ---
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_ENVIRONMENT=sandbox         # sandbox | production
INTUIT_REDIRECT_URI=http://localhost:3000/api/connect/qbo/callback
INTUIT_WEBHOOK_VERIFIER_TOKEN=     # optional to connect; REQUIRED for /api/webhooks/qbo (T-053): unset = the endpoint answers 503. Set at H-024

# --- Stripe ---
STRIPE_RESTRICTED_KEY=             # read-only restricted key
STRIPE_WEBHOOK_SECRET=

# --- GoHighLevel ---
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=

# --- monday.com ---
MONDAY_API_TOKEN=

# --- Notion ---
NOTION_INTEGRATION_TOKEN=

# --- Web push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=      # public by design; the browser needs it to subscribe
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Observability (optional) ---
NEXT_PUBLIC_SENTRY_DSN=            # a DSN is not a secret; client + server SDKs use it
