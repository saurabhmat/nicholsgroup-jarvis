{
  "name": "nicholsgroup-jarvis",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@nichols/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test && node --test scripts/next-task.test.mjs",
    "test:db": "node -e \"console.log('test:db: placeholder, real pgTAP suite arrives in T-006')\"",
    "test:injection": "node -e \"console.log('test:injection: placeholder, real suite arrives in T-102')\""
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "turbo": "^2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
